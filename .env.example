# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
# Public origin of the app. Used for canonical URLs, emails and payment callbacks.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Aurelia

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jewels_dev?schema=public
# Only used by `pnpm test:integration`. MUST point at a throwaway database:
# the integration suite truncates every table before each file.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jewels_test?schema=public

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# 32+ random bytes, base64. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-characters-of-random-data
SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Commerce
# ---------------------------------------------------------------------------
# GST on jewellery is 3% in India. Basis points: 300 = 3.00%.
DEFAULT_TAX_RATE_BPS=300
CURRENCY=INR
# How long a checkout holds stock before the reservation expires.
INVENTORY_RESERVATION_MINUTES=15
FREE_SHIPPING_THRESHOLD_MINOR=5000000

# ---------------------------------------------------------------------------
# Payments — Razorpay
# ---------------------------------------------------------------------------
# PAYMENT_PROVIDER=razorpay | fake
# `fake` is a deterministic, signature-verifying local driver. It exists so the
# checkout state machine can be exercised without credentials. It is rejected
# when NODE_ENV=production.
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---------------------------------------------------------------------------
# Object storage — S3 compatible (AWS S3, Cloudflare R2, MinIO)
# ---------------------------------------------------------------------------
# STORAGE_DRIVER=s3 | local
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL that serves objects from the bucket (CDN origin).
S3_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# EMAIL_DRIVER=resend | console
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM="Aurelia <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Seeding (development only)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@aurelia.test
SEED_ADMIN_PASSWORD=Admin!2345
SEED_CUSTOMER_EMAIL=customer@aurelia.test
SEED_CUSTOMER_PASSWORD=Customer!2345
